[Unit]
Description=Home Assistant OS 16.3+ in QEMU/KVM
Wants=network-online.target
After=NetworkManager.service network-online.target

[Service]
Type=exec

ExecStart=/opt/vz/haos_vm/haosctl.sh run
ExecStop=/opt/vz/haos_vm/haosctl.sh stop

Restart=on-failure
RestartSec=10

TimeoutStartSec=60
TimeoutStopSec=160

KillMode=control-group

[Install]
WantedBy=multi-user.target
