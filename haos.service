[Unit]
Description=Home Assistant OS 16.3 on QEMU/KVM (Rock 4SE)
Wants=network-online.target
After=NetworkManager.service network-online.target

[Service]
Type=exec
ExecStart=/opt/vz/haos_vm/haosctl.sh run
ExecStop=/opt/vz/haos_vm/haosctl.sh stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=180
KillMode=control-group

[Install]
WantedBy=multi-user.target
